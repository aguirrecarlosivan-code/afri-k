# Radar Platform Environment Configuration

# App Configuration
APP_NAME=Radar
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-radar-key-change-in-production

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=radar_password
POSTGRES_DB=radar_db
DATABASE_URL=postgresql+asyncpg://radar_user:radar_password@localhost:5432/radar_db

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# AI Intelligence Module Configuration
AI_PROVIDER=gemini  # Options: gemini, openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-2.5-flash

# Social Media API Credentials (Meta Graph API)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_token

INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

YOUTUBE_API_KEY=your_youtube_api_key
TIKTOK_CLIENT_KEY=your_tiktok_client_key
X_BEARER_TOKEN=your_x_bearer_token

# Scheduler Configuration
SCHEDULER_ENABLED=True
WEEKLY_REPORT_CRON_DAY=fri
WEEKLY_REPORT_CRON_HOUR=22
WEEKLY_REPORT_CRON_MINUTE=00
